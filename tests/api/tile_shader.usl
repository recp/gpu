vert tile_vs(vertexId: uint #vertex_id) -> float4 {
  let x = float(vertexId & 1u) * 4.0 - 1.0
  let y = float((vertexId >> 1u) & 1u) * 4.0 - 1.0
  return float4(x, y, 0.0, 1.0)
}

frag tile_draw_fs(dst: float4 #color(0)) -> float4 {
  return dst * 0.5 + float4(0.125, 0.25, 0.0625, 0.125)
}

frag tile_transform_fs(dst: float4 #color(0)) -> float4 {
  return float4(dst.z, dst.x, dst.w, dst.y) * 0.5
         + float4(0.25, 0.125, 0.0625, 0.25)
}
