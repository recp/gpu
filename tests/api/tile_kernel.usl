struct KernelMaster {
  rgba: float4 #raster_order(0)
}

struct KernelOutput {
  data: KernelMaster #imageblock
}

vert kernel_vs(vertexId: uint #vertex_id) -> float4 {
  return float4(float(vertexId & 1u) * 4.0 - 1.0,
                float((vertexId >> 1u) & 1u) * 4.0 - 1.0, 0.0, 1.0)
}

frag kernel_init_fs() -> KernelOutput {
  return KernelOutput { KernelMaster { float4(0.125, 0.25, 0.375, 0.5) } }
}

frag kernel_resolve_fs(data: KernelMaster #imageblock) -> float4 {
  return data.rgba
}

@tile
kern kernel_update(inout block: imageblock<KernelMaster>,
                   config:      [uint] #buffer(3),
                   local:       uint3  #local_id,
                   group:       uint3  #workgroup_id) {
  let width   = block.get_width()
  let height  = block.get_height()
  let samples = block.get_num_samples()
  let stride  = config[2]
  var cached: [float4; 16]

  for (var y = local.y; y < height; y += stride) {
    for (var x = local.x; x < width; x += stride) {
      let pixel = group.xy * uint2(width, height) + uint2(x, y)
      for (var sample = 0u; sample < samples; sample += 1u) {
        var value = KernelMaster { float4(-0.125, -0.25, -0.375, -0.5) }
        if (pixel.x < config[0] && pixel.y < config[1]) {
          value = block.read(ushort2(x, y), ushort(sample))
        }
        value.rgba += float4(float(x) / 32.0, float(y) / 64.0,
                             float(sample) / 16.0, float(group.x + group.y * 2u) / 16.0)
        block.write(value, ushort2(x, y), ushort(sample))
      }
    }
  }
  imageblock_barrier()

  var index = 0u
  for (var y = local.y; y < height; y += stride) {
    for (var x = local.x; x < width; x += stride) {
      let neighbor = ushort2((x + 7u) % width, (y + 5u) % height)
      for (var sample = 0u; sample < samples; sample += 1u) {
        let value = block.read(neighbor, ushort(sample))
        cached[index] = value.rgba
        index += 1u
      }
    }
  }
  imageblock_barrier()

  index = 0u
  for (var y = local.y; y < height; y += stride) {
    for (var x = local.x; x < width; x += stride) {
      for (var sample = 0u; sample < samples; sample += 1u) {
        let value = KernelMaster {
          cached[index] * 0.5 + float4(float(config[3]) / 256.0, 0.0625, 0.03125, 0.125)
        }
        block.write(value, ushort2(x, y), ushort(sample))
        index += 1u
      }
    }
  }
}

kern(1)
ordinary_kernel(config: [uint] #buffer(3)) {
  let unused = config[0]
}

@tile
kern kernel_readonly(block: imageblock<KernelMaster>, local: uint3 #local_id) {
  let value = block.read(ushort2(local.x, local.y))
}

@tile
kern kernel_uniform(inout block: imageblock<KernelMaster>,
                    local:       uint3 #local_id,
                    group:       uint3 #workgroup_id) {
  let width   = block.get_width()
  let height  = block.get_height()
  let samples = block.get_num_samples()
  let xy      = ushort2(local.x, local.y)
  let initial = float4(float(local.x) / 32.0, float(local.y) / 64.0,
                       0.25, 0.5 + float(group.x + group.y * 2u) / 16.0)
  let offset  = float4(0.125, 0.0625, 0.03125, 0.25)

  block.write(KernelMaster { initial }, xy, ushort(0))
  if (samples == 4u) {
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.0625, 0.0) }, xy, ushort(1))
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.125, 0.0) }, xy, ushort(2))
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.1875, 0.0) }, xy, ushort(3))
  }
  imageblock_barrier()

  /* adding 17 makes one 256-pixel cycle, crossing any smaller SIMD partition */
  let next     = (local.y * width + local.x + 17u) % (width * height)
  let neighbor = ushort2(next % width, next / width)

  if (((group.x + group.y) & 1u) == 0u) {
    var value0 = block.read(neighbor, ushort(0))
    var value1 = value0
    var value2 = value0
    var value3 = value0
    if (samples == 4u) {
      value1 = block.read(neighbor, ushort(1))
      value2 = block.read(neighbor, ushort(2))
      value3 = block.read(neighbor, ushort(3))
    }
    imageblock_barrier()

    block.write(KernelMaster { value0.rgba * 0.5 + offset }, xy, ushort(0))
    if (samples == 4u) {
      block.write(KernelMaster { value1.rgba * 0.5 + offset }, xy, ushort(1))
      block.write(KernelMaster { value2.rgba * 0.5 + offset }, xy, ushort(2))
      block.write(KernelMaster { value3.rgba * 0.5 + offset }, xy, ushort(3))
    }
    imageblock_barrier()
  }

  if (width == height) {
    var value0 = block.read(neighbor, ushort(0))
    var value1 = value0
    var value2 = value0
    var value3 = value0
    if (samples == 4u) {
      value1 = block.read(neighbor, ushort(1))
      value2 = block.read(neighbor, ushort(2))
      value3 = block.read(neighbor, ushort(3))
    }
    imageblock_barrier()

    block.write(KernelMaster { value0.rgba * 0.5 + offset }, xy, ushort(0))
    if (samples == 4u) {
      block.write(KernelMaster { value1.rgba * 0.5 + offset }, xy, ushort(1))
      block.write(KernelMaster { value2.rgba * 0.5 + offset }, xy, ushort(2))
      block.write(KernelMaster { value3.rgba * 0.5 + offset }, xy, ushort(3))
    }
    imageblock_barrier()
  }
}

@tile
kern kernel_loop(inout block: imageblock<KernelMaster>,
                 local:       uint3 #local_id,
                 group:       uint3 #workgroup_id) {
  let width   = block.get_width()
  let height  = block.get_height()
  let samples = block.get_num_samples()
  let limit   = (group.x + group.y * 2u) & 3u
  let xy      = ushort2(local.x, local.y)
  let initial = float4(float(local.x) / 32.0, float(local.y) / 64.0,
                       0.25, 0.5 + float(group.x + group.y * 2u) / 16.0)
  let offset  = float4(0.125, 0.0625, 0.03125, 0.25)

  block.write(KernelMaster { initial }, xy, ushort(0))
  if (samples == 4u) {
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.0625, 0.0) }, xy, ushort(1))
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.125, 0.0) }, xy, ushort(2))
    block.write(KernelMaster { initial + float4(0.0, 0.0, 0.1875, 0.0) }, xy, ushort(3))
  }
  imageblock_barrier()

  /* adding 17 makes one 256-pixel cycle, crossing any smaller SIMD partition */
  let next     = (local.y * width + local.x + 17u) % (width * height)
  let neighbor = ushort2(next % width, next / width)

  for (var iteration = 0u; iteration < limit; iteration += 1u) {
    var value0 = block.read(neighbor, ushort(0))
    var value1 = value0
    var value2 = value0
    var value3 = value0
    if (samples == 4u) {
      value1 = block.read(neighbor, ushort(1))
      value2 = block.read(neighbor, ushort(2))
      value3 = block.read(neighbor, ushort(3))
    }
    imageblock_barrier()

    block.write(KernelMaster { value0.rgba * 0.5 + offset }, xy, ushort(0))
    if (samples == 4u) {
      block.write(KernelMaster { value1.rgba * 0.5 + offset }, xy, ushort(1))
      block.write(KernelMaster { value2.rgba * 0.5 + offset }, xy, ushort(2))
      block.write(KernelMaster { value3.rgba * 0.5 + offset }, xy, ushort(3))
    }
    imageblock_barrier()
  }
}
