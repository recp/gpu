kern(1) write_first(inout data: [uint] #buffer(11)) {
  data[0] = 29u
}

kern(1) read_first(data:         [uint] #buffer(5),
                   inout result: [uint] #buffer(7)) {
  result[0] = data[0] + 13u
}

kern(1) read_after(data:         [uint] #buffer(11),
                   inout result: [uint] #buffer(7)) {
  result[0] = data[0] + 13u
}

kern(1) write_after(inout data: [uint] #buffer(5)) {
  data[0] = 29u
}

kern(1) unused_write(inout data: [uint] #buffer(8)) {
}

kern(1) read_unused(data:         [uint] #buffer(8),
                    inout result: [uint] #buffer(7)) {
  result[0] = data[0] + 13u
}

kern(1) read_group(data:         [uint] #buffer(5) #group(1),
                   inout result: [uint] #buffer(7)) {
  result[0] = data[0] + 13u
}
