struct VertexOutput {
  position: float4 #position
  value:    half3  #attribute(0)
}

vert shader_vs(id: uint #vertex_id) -> VertexOutput {
  return VertexOutput { float4(float(id), 0.0, 0.0, 1.0), half3(0.25, 0.5, 0.75) }
}

frag shader_fs(value: half3 #attribute(0)) -> float4 {
  return float4(float(value.x), float(value.y), float(value.z), 1.0)
}
