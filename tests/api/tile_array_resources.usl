@require(descriptor_indexing)

frag array_resource_fs(dst:      float4                   #color(0),
                       buffers:  [buffer_view<float4>; 2] #buffer(5) #group(1) #dynamic_offset,
                       textures: [texture2d<float>; 2]    #texture(9) #group(1),
                       samplers: [sampler; 2]             #sampler(11) #group(1)) -> float4 {
  return dst * 0.5 + buffers[0][0] + buffers[1][0] * 0.5
         + textures[0].sample(samplers[0], float2(1.25, 0.5), level(0.0))
         + textures[1].sample(samplers[1], float2(1.25, 0.5), level(0.0)) * 0.5
}
