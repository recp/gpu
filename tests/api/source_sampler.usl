vertex SourceSamplerVSIn {
  position: float4
  uv:       float2
}

pub struct SourceSamplerVSOut {
  position: float4 #position
  uv:       float2
}

struct SourceSamplerUniforms {
  tint: float4
}

vert source_sampler_vs(input: SourceSamplerVSIn #stage_in) -> SourceSamplerVSOut {
  input.position, input.uv
}

frag source_sampler_fs(input: SourceSamplerVSOut #stage_in,
                       colorTex: texture2d_array<float> #texture(0) #group(1),
                       uniforms: SourceSamplerUniforms #buffer(1) #group(1)) -> float4 {
  let linearSampler = sampler(.linear, .linear, .linear, .clampToEdge)
  return colorTex.sample(linearSampler,
                         float3(input.uv, 0.0),
                         max_anisotropy(8)) * uniforms.tint
}
