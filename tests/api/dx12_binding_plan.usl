struct BindingPlanConstants {
  scale: float4
}

kern(1, 1, 1) dx12_binding_plan_cs(
  constants0: BindingPlanConstants #buffer(0) #group(0) #dynamic_offset,
  input0: [float4] #buffer(1) #group(0),
  inout output0: [float4] #buffer(2) #group(0),
  texture0: texture2d<float> #texture(3) #group(0),
  sampler0: sampler #sampler(4) #group(0),
  constants1: BindingPlanConstants #buffer(0) #group(1) #dynamic_offset,
  input1: [float4] #buffer(1) #group(1),
  inout output1: [float4] #buffer(2) #group(1),
  texture1: texture2d<float> #texture(3) #group(1),
  sampler1: sampler #sampler(4) #group(1)
) {
  output0[0] = input0[0] * constants0.scale
             + texture0.sample(sampler0, float2(0.5), level(0.0))
  output1[0] = input1[0] * constants1.scale
             + texture1.sample(sampler1, float2(0.5), level(0.0))
}
