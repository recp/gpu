struct Scratch {
  rgba: float4 #raster_order(0)
}

struct ScratchOutput {
  data: Scratch #imageblock
}

vert block_vs(vertexId: uint #vertex_id) -> float4 {
  let x = float(vertexId & 1u) * 4.0 - 1.0
  let y = float((vertexId >> 1u) & 1u) * 4.0 - 1.0
  return float4(x, y, 0.0, 1.0)
}

frag block_init_fs() -> ScratchOutput {
  return ScratchOutput { Scratch { float4(0.125, 0.25, 0.375, 0.5) } }
}

frag block_draw_fs(data: Scratch #imageblock) -> ScratchOutput {
  return ScratchOutput { Scratch {
    data.rgba * 0.5 + float4(0.125, 0.25, 0.0625, 0.125)
  } }
}

frag block_resolve_fs(data: Scratch #imageblock) -> float4 {
  return float4(data.rgba.z, data.rgba.x, data.rgba.w, data.rgba.y) * 0.5
         + float4(0.25, 0.125, 0.0625, 0.25)
}
