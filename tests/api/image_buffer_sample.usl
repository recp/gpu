kern(8, 8) image_buffer_sample_cs(
  source:     texture2d<float> #texture(0),
  inout out:  [float4]         #buffer(1),
  pixel:      uint2            #global_id
) {
  if (pixel.x < source.get_width() && pixel.y < source.get_height()) {
    out[pixel.y * source.get_width() + pixel.x] = source.read(pixel) + float4(1.0)
  }
}
