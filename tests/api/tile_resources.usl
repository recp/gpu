vert resource_vs(vertexId: uint #vertex_id) -> float4 {
  let x = float(vertexId & 1u) * 4.0 - 1.0
  let y = float((vertexId >> 1u) & 1u) * 4.0 - 1.0
  return float4(x, y, 0.0, 1.0)
}

struct Adjust {
  add: float4
}

frag resource_fs(dst:     float4          #color(0),
                 weight:  float4          #buffer(5) #group(1) #dynamic_offset,
                 values:  [float4]        #buffer(7) #group(1) #dynamic_offset,
                 image:   texture2d<float> #texture(9) #group(2),
                 filter:  sampler         #sampler(11) #group(2),
                 adjust:  Adjust          #push_constant) -> float4 {
  return dst * 0.5 + weight + values[0]
         + image.sample(filter, float2(1.25, 0.5), level(0.0)) + adjust.add
}

frag resource_idle_fs(dst: float4 #color(0)) -> float4 {
  return dst * 0.5
}
