// texel reads: read-only arrays a device may read through texel views; the app binds plain storage buffers either way
kern(64) texel_reads(w: [uint4] #buffer(0),
                     x: [half4] #buffer(1),
                     s: [float] #buffer(2),
                     wout: &mut [uint4] #buffer(3),
                     fout: &mut [float4] #buffer(4),
                     i: uint #global_id) {
  wout[i] = w[i]
  fout[i] = float4(x[i]) + float4(s[i])
}
