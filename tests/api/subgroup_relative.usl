kern(64, 1, 1) subgroup_relative_cs(
    values: &[uint] #buffer(0) #group(0),
    relative: &mut [uint] #buffer(1) #group(0),
    gid: uint #global_id) {
  let value = values[gid as usize]
  relative[gid as usize] = simd_shuffle_and_fill_down(value,
                                                      value + 1000u,
                                                      1u)
}
