kern(1, 1, 1) f64_core(input: [double4] #buffer(0),
                        inout output: [double4] #buffer(1),
                        inout packed: [float2] #buffer(2),
                        inout integer: [int2] #buffer(3),
                        sqrtInput: [double4] #buffer(4),
                        gid: uint3 #global_id) {
  let index      = gid.x
  let value      = input[index]
  let shifted    = value + double4(0.5, 1.0, 1.5, 2.0)
  let comparison = value.y < value.z
  let selected   = comparison ? value.w : value.x
  let extended   = double(packed[index].x)
  let converted  = double(integer[index].x)
  let normal     = double4(0.5, -1.0, 2.0, 0.25)

  output[index * 14u]      = shifted
  output[index * 14u + 1u] = double4(value.x * double(2.0) + double(1.25),
                                     min(value.y, value.z),
                                     selected,
                                     extended + converted)
  output[index * 14u + 2u] = min(value, double4(0.5))
  output[index * 14u + 3u] = max(value, double4(-0.5))
  output[index * 14u + 4u] = clamp(value, double4(-1.0), double4(1.0))
  output[index * 14u + 5u] = saturate(value)
  output[index * 14u + 6u] = sign(value)
  output[index * 14u + 7u] = abs(value)
  output[index * 14u + 8u] = double4(dot(value.xy, normal.xy),
                                     dot(value.xyz, normal.xyz),
                                     dot(value, normal),
                                     1.0)
  output[index * 14u + 9u] = double4(cross(value.xyz, normal.xyz), 1.0)
  output[index * 14u + 10u] = reflect(value, normal)
  output[index * 14u + 11u] = faceforward(value, normal, value)
  output[index * 14u + 12u] = project(value, normal)
  output[index * 14u + 13u] = reject(value, normal)
  output[14u] = sqrt(sqrtInput[0u])
  output[15u] = sqrt(sqrtInput[1u])
  output[16u] = sqrt(sqrtInput[2u])
  output[17u] = double4(length(value.xy),
                        length(value.xyz),
                        length(value),
                        distance(value, normal))
  output[18u] = double4(distance(value.xy, normal.xy),
                        distance(value.xyz, normal.xyz),
                        normalize(value.xy))
  output[19u] = double4(normalize(value.xyz), 1.0)
  output[20u] = normalize(value)
  output[21u] = refract(double4(0.0, -1.0, 0.0, 0.0),
                        double4(0.0, 1.0, 0.0, 0.0),
                        0.75)
  output[22u] = refract(double4(1.0, 0.0, 0.0, 0.0),
                        double4(0.0, 1.0, 0.0, 0.0),
                        2.0)
  packed[index]            = float2(float(value.z), float(value.w))
  integer[index]           = int2(int(value.x), int(value.y))
}
