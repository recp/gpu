@require(shader_f16)
kern(1, 1, 1) f16_builtins(
  values:       [float4] #buffer(0),
  inout output: [half4] #buffer(1),
  gid:           uint3 #global_id
) {
  let inputBase = gid.x * 2u
  let out       = gid.x * 84u
  let a         = half4(values[inputBase])
  let b         = half4(values[inputBase + 1u])
  let positiveA = abs(a) + half(0.25)
  let positiveB = abs(b) + half(0.25)
  let a3        = a.xyz
  let b3        = b.xyz
  let geo       = out + 32u
  let trig      = geo + 8u
  let widthOut  = out + 56u

  output[out]       = half4(floor(a))
  output[out + 1u]  = half4(ceil(a))
  output[out + 2u]  = half4(round(a))
  output[out + 3u]  = half4(trunc(a))
  output[out + 4u]  = half4(fract(a))
  output[out + 5u]  = half4(sqrt(positiveA))
  output[out + 6u]  = half4(rsqrt(positiveA))
  output[out + 7u]  = half4(inversesqrt(positiveB))
  output[out + 8u]  = half4(rcp(a))
  output[out + 9u]  = half4(exp(a))
  output[out + 10u] = half4(exp2(a))
  output[out + 11u] = half4(log(positiveA))
  output[out + 12u] = half4(log2(positiveA))
  output[out + 13u] = half4(degrees(a))
  output[out + 14u] = half4(radians(a))
  output[out + 15u] = half4(saturate(a))
  output[out + 16u] = half4(abs(a))
  output[out + 17u] = half4(sign(a))
  output[out + 18u] = half4(pow(positiveA, b))
  output[out + 19u] = half4(mod(a, b))
  output[out + 20u] = half4(fmod(a, b))
  output[out + 21u] = half4(min(a, b))
  output[out + 22u] = half4(max(a, b))
  output[out + 23u] = half4(clamp(a, half(-1.0), half(1.0)))
  output[out + 24u] = half4(step(b, a))
  output[out + 25u] = half4(copysign(a, b))
  output[out + 26u] = half4(mix(a, b, half(0.25)))
  output[out + 27u] = half4(lerp(a, b, half(0.75)))
  output[out + 28u] = half4(smoothstep(half(-1.0), half(1.0), a))
  output[out + 29u] = half4(fma(a, b, half(0.5)))
  output[out + 30u] = half4(inverselerp(a, b, -a))
  output[out + 31u] = half4(remap(a, b, -b, b, -a))

  output[geo]      = half4(dot(a, b),
                            length(a),
                            distance(a, b),
                            half(0.0))
  output[geo + 1u] = half4(cross(a3, b3), half(1.0))
  output[geo + 2u] = half4(normalize(a))
  output[geo + 3u] = half4(reflect(a, b))
  output[geo + 4u] = half4(project(a, b))
  output[geo + 5u] = half4(reject(a, b))
  output[geo + 6u] = half4(refract(a, b, half(0.75)))
  output[geo + 7u] = half4(faceforward(a, b, a))

  output[trig]       = half4(sin(a))
  output[trig + 1u]  = half4(cos(a))
  output[trig + 2u]  = half4(tan(a))
  output[trig + 3u]  = half4(asin(a))
  output[trig + 4u]  = half4(acos(a))
  output[trig + 5u]  = half4(atan(a))
  output[trig + 6u]  = half4(acot(a))
  output[trig + 7u]  = half4(asec(a))
  output[trig + 8u]  = half4(acsc(a))
  output[trig + 9u]  = half4(atan2(a, b))
  output[trig + 10u] = half4(sinh(a))
  output[trig + 11u] = half4(cosh(a))
  output[trig + 12u] = half4(tanh(a))
  output[trig + 13u] = half4(asinh(a))
  output[trig + 14u] = half4(acosh(a))
  output[trig + 15u] = half4(atanh(a))

  output[widthOut]      = half4(fract(a.x), half3(0.0))
  output[widthOut + 1u] = half4(sign(a.x), half3(0.0))
  output[widthOut + 2u] = half4(step(b.x, a.x), half3(0.0))
  output[widthOut + 3u] = half4(smoothstep(half(-1.0), half(1.0), a.x),
                                 half3(0.0))
  output[widthOut + 4u] = half4(atan(a.x), half3(0.0))
  output[widthOut + 5u] = half4(tanh(a.x), half3(0.0))
  output[widthOut + 6u] = half4(asinh(a.x), half3(0.0))

  output[widthOut + 7u]  = half4(fract(a.xy), half2(0.0))
  output[widthOut + 8u]  = half4(sign(a.xy), half2(0.0))
  output[widthOut + 9u]  = half4(step(b.xy, a.xy), half2(0.0))
  output[widthOut + 10u] = half4(smoothstep(half(-1.0), half(1.0), a.xy),
                                  half2(0.0))
  output[widthOut + 11u] = half4(atan(a.xy), half2(0.0))
  output[widthOut + 12u] = half4(tanh(a.xy), half2(0.0))
  output[widthOut + 13u] = half4(asinh(a.xy), half2(0.0))

  output[widthOut + 14u] = half4(fract(a3), half(0.0))
  output[widthOut + 15u] = half4(sign(a3), half(0.0))
  output[widthOut + 16u] = half4(step(b3, a3), half(0.0))
  output[widthOut + 17u] = half4(smoothstep(half(-1.0), half(1.0), a3),
                                  half(0.0))
  output[widthOut + 18u] = half4(atan(a3), half(0.0))
  output[widthOut + 19u] = half4(tanh(a3), half(0.0))
  output[widthOut + 20u] = half4(asinh(a3), half(0.0))

  output[widthOut + 21u] = half4(fract(a))
  output[widthOut + 22u] = half4(sign(a))
  output[widthOut + 23u] = half4(step(b, a))
  output[widthOut + 24u] = half4(smoothstep(half(-1.0), half(1.0), a))
  output[widthOut + 25u] = half4(atan(a))
  output[widthOut + 26u] = half4(tanh(a))
  output[widthOut + 27u] = half4(asinh(a))
}
