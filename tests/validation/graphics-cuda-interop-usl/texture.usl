  let halfBase = texelCount * 2u + 6u + 12u
  let r8UnormBase = halfBase + texelCount * 2u * 11u
  let r8SnormBase = r8UnormBase + texelCount * 2u
  let r8UintBase = r8SnormBase + texelCount * 2u
  let r8SintBase = r8UintBase + texelCount * 2u
  let r16UnormBase = r8SintBase + texelCount * 2u
  let r16SnormBase = r16UnormBase + texelCount * 2u
  let r16UintBase = r16SnormBase + texelCount * 2u
  let r16SintBase = r16UintBase + texelCount * 2u
  let r16FloatBase = r16SintBase + texelCount * 2u
  let r32UintBase = r16FloatBase + texelCount * 2u
  let r32SintBase = r32UintBase + texelCount * 2u
  let r32FloatBase = r32SintBase + texelCount * 2u
  let rg8UnormBase = r32FloatBase + texelCount * 2u
  let rg8SnormBase = rg8UnormBase + texelCount * 2u
  let rg8UintBase = rg8SnormBase + texelCount * 2u
  let rg8SintBase = rg8UintBase + texelCount * 2u
  let rg16UnormBase = rg8SintBase + texelCount * 2u
  let rg16SnormBase = rg16UnormBase + texelCount * 2u
  let rg16UintBase = rg16SnormBase + texelCount * 2u
  let rg16SintBase = rg16UintBase + texelCount * 2u
  let rg16FloatBase = rg16SintBase + texelCount * 2u
  let rg32UintBase = rg16FloatBase + texelCount * 2u
  let rg32SintBase = rg32UintBase + texelCount * 2u
  let rg32FloatBase = rg32SintBase + texelCount * 2u
  let index = (gid.z * 8u + gid.y) * 8u + gid.x
  let r8UnormColor = float4(1.0) - r8UnormImage.read(gid)
  r8UnormImage.write(r8UnormColor, gid)
  output[r8UnormBase + texelCount + index] = r8UnormColor
  let r8SnormColor = -r8SnormImage.read(gid)
  r8SnormImage.write(r8SnormColor, gid)
  output[r8SnormBase + texelCount + index] = r8SnormColor
  let r8UintColor = r8UintImage.read(gid) + uint4(1u)
  r8UintImage.write(r8UintColor, gid)
  output[r8UintBase + texelCount + index] = float4(r8UintColor)
  let r8SintColor = r8SintImage.read(gid) + int4(7)
  r8SintImage.write(r8SintColor, gid)
  output[r8SintBase + texelCount + index] = float4(r8SintColor)
  let r16UnormColor = float4(1.0) - r16UnormImage.read(gid)
  r16UnormImage.write(r16UnormColor, gid)
  output[r16UnormBase + texelCount + index] = r16UnormColor
  let r16SnormColor = -r16SnormImage.read(gid)
  r16SnormImage.write(r16SnormColor, gid)
  output[r16SnormBase + texelCount + index] = r16SnormColor
  let r16UintColor = r16UintImage.read(gid) + uint4(1u)
  r16UintImage.write(r16UintColor, gid)
  output[r16UintBase + texelCount + index] = float4(r16UintColor)
  let r16SintColor = r16SintImage.read(gid) + int4(7)
  r16SintImage.write(r16SintColor, gid)
  output[r16SintBase + texelCount + index] = float4(r16SintColor)
  let r16FloatColor = r16FloatImage.read(gid) * 2.0 + float4(1.0)
  r16FloatImage.write(r16FloatColor, gid)
  output[r16FloatBase + texelCount + index] = r16FloatColor
  let r32UintColor = r32UintImage.read(gid) + uint4(1u)
  r32UintImage.write(r32UintColor, gid)
  output[r32UintBase + texelCount + index] = float4(r32UintColor)
  let r32SintColor = r32SintImage.read(gid) + int4(7)
  r32SintImage.write(r32SintColor, gid)
  output[r32SintBase + texelCount + index] = float4(r32SintColor)
  let r32FloatColor = r32FloatImage.read(gid) * 2.0 + float4(1.0)
  r32FloatImage.write(r32FloatColor, gid)
  output[r32FloatBase + texelCount + index] = r32FloatColor
  let rg8UnormColor = float4(1.0) - rg8UnormImage.read(gid)
  rg8UnormImage.write(rg8UnormColor, gid)
  output[rg8UnormBase + texelCount + index] = rg8UnormColor
  let rg8SnormColor = -rg8SnormImage.read(gid)
  rg8SnormImage.write(rg8SnormColor, gid)
  output[rg8SnormBase + texelCount + index] = rg8SnormColor
  let rg8UintColor = rg8UintImage.read(gid) + uint4(1u)
  rg8UintImage.write(rg8UintColor, gid)
  output[rg8UintBase + texelCount + index] = float4(rg8UintColor)
  let rg8SintColor = rg8SintImage.read(gid) + int4(7)
  rg8SintImage.write(rg8SintColor, gid)
  output[rg8SintBase + texelCount + index] = float4(rg8SintColor)
  let rg16UnormColor = float4(1.0) - rg16UnormImage.read(gid)
  rg16UnormImage.write(rg16UnormColor, gid)
  output[rg16UnormBase + texelCount + index] = rg16UnormColor
  let rg16SnormColor = -rg16SnormImage.read(gid)
  rg16SnormImage.write(rg16SnormColor, gid)
  output[rg16SnormBase + texelCount + index] = rg16SnormColor
  let rg16UintColor = rg16UintImage.read(gid) + uint4(1u)
  rg16UintImage.write(rg16UintColor, gid)
  output[rg16UintBase + texelCount + index] = float4(rg16UintColor)
  let rg16SintColor = rg16SintImage.read(gid) + int4(7)
  rg16SintImage.write(rg16SintColor, gid)
  output[rg16SintBase + texelCount + index] = float4(rg16SintColor)
  let rg16FloatColor = rg16FloatImage.read(gid) * 2.0 + float4(1.0)
  rg16FloatImage.write(rg16FloatColor, gid)
  output[rg16FloatBase + texelCount + index] = rg16FloatColor
  let rg32UintColor = rg32UintImage.read(gid) + uint4(1u)
  rg32UintImage.write(rg32UintColor, gid)
  output[rg32UintBase + texelCount + index] = float4(rg32UintColor)
  let rg32SintColor = rg32SintImage.read(gid) + int4(7)
  rg32SintImage.write(rg32SintColor, gid)
  output[rg32SintBase + texelCount + index] = float4(rg32SintColor)
  let rg32FloatColor = rg32FloatImage.read(gid) * 2.0 + float4(1.0)
  rg32FloatImage.write(rg32FloatColor, gid)
  output[rg32FloatBase + texelCount + index] = rg32FloatColor
}
