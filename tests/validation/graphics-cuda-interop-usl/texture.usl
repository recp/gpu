fn cube_direction(face: uint) -> float3 {
  if face == 0u {
    return float3(1.0, 0.0, 0.0)
  } else if face == 1u {
    return float3(-1.0, 0.0, 0.0)
  } else if face == 2u {
    return float3(0.0, 1.0, 0.0)
  } else if face == 3u {
    return float3(0.0, -1.0, 0.0)
  } else if face == 4u {
    return float3(0.0, 0.0, 1.0)
  }
  return float3(0.0, 0.0, -1.0)
}

kern(8, 8, 1) interop_texture_sample_cs(
  inout output: [float4] #buffer(1),
  sampled: texture2d_array<float> #texture(2),
  cube: texturecube<float> #texture(3),
  cubeArray: texturecube_array<float> #texture(4),
  halfSampled: texture2d_array<half> #texture(6),
  unorm8Sampled: texture2d_array<float> #texture(8),
  snorm8Sampled: texture2d_array<float> #texture(10),
  uint8Sampled: texture2d_array<uint> #texture(12),
  sint8Sampled: texture2d_array<int> #texture(14),
  unorm16Sampled: texture2d_array<float> #texture(16),
  snorm16Sampled: texture2d_array<float> #texture(18),
  uint16Sampled: texture2d_array<uint> #texture(20),
  sint16Sampled: texture2d_array<int> #texture(22),
  uint32Sampled: texture2d_array<uint> #texture(24),
  sint32Sampled: texture2d_array<int> #texture(26),
  srgbSampled: texture2d_array<float> #texture(27),
  gid: uint3 #global_id
) {
  let texelCount = 8u * 8u * 2u
  let halfBase = texelCount * 2u + 6u + 12u
  let unorm8Base = halfBase + texelCount * 2u
  let snorm8Base = unorm8Base + texelCount * 2u
  let uint8Base = snorm8Base + texelCount * 2u
  let sint8Base = uint8Base + texelCount * 2u
  let unorm16Base = sint8Base + texelCount * 2u
  let snorm16Base = unorm16Base + texelCount * 2u
  let uint16Base = snorm16Base + texelCount * 2u
  let sint16Base = uint16Base + texelCount * 2u
  let uint32Base = sint16Base + texelCount * 2u
  let sint32Base = uint32Base + texelCount * 2u
  let srgbBase = halfBase + texelCount * 2u * (11u + 24u)
  if gid.z < 2u {
    let index = (gid.z * 8u + gid.y) * 8u + gid.x
    let original = sampled.read(int3(gid))
    let halfOriginal = halfSampled.read(int3(gid))
    let unorm8Original = unorm8Sampled.read(int3(gid))
    let snorm8Original = snorm8Sampled.read(int3(gid))
    let uint8Original = uint8Sampled.read(int3(gid))
    let sint8Original = sint8Sampled.read(int3(gid))
    let unorm16Original = unorm16Sampled.read(int3(gid))
    let snorm16Original = snorm16Sampled.read(int3(gid))
    let uint16Original = uint16Sampled.read(int3(gid))
    let sint16Original = sint16Sampled.read(int3(gid))
    let uint32Original = uint32Sampled.read(int3(gid))
    let sint32Original = sint32Sampled.read(int3(gid))
    let srgbOriginal = srgbSampled.read(int3(gid))
    output[index] = original
    output[halfBase + index] = float4(halfOriginal)
    output[unorm8Base + index] = unorm8Original
    output[snorm8Base + index] = snorm8Original
    output[uint8Base + index] = float4(uint8Original)
    output[sint8Base + index] = float4(sint8Original)
    output[unorm16Base + index] = unorm16Original
    output[snorm16Base + index] = snorm16Original
    output[uint16Base + index] = float4(uint16Original)
    output[sint16Base + index] = float4(sint16Original)
    output[uint32Base + index] = float4(uint32Original)
    output[sint32Base + index] = float4(sint32Original)
    output[srgbBase + index] = srgbOriginal
  }
  if gid.x == 0u && gid.y == 0u && gid.z < 6u {
    output[texelCount * 2u + gid.z] = cube.sample(
      .nearest,
      cube_direction(gid.z),
      level(0.0)
    )
  }
  if gid.x == 0u && gid.y == 0u {
    let face = gid.z % 6u
    let cubeIndex = gid.z / 6u
    output[texelCount * 2u + 6u + gid.z] = cubeArray.sample(
      .nearest,
      float4(cube_direction(face), float(cubeIndex)),
      level(0.0)
    )
  }
}

kern(8, 8, 1) interop_texture_store_cs(
  image: image2d_array<rgba32float, read_write> #texture(0),
  inout output: [float4] #buffer(1),
  halfImage: image2d_array<rgba16float, read_write> #texture(5),
  unorm8Image: image2d_array<rgba8unorm, read_write> #texture(7),
  snorm8Image: image2d_array<rgba8snorm, read_write> #texture(9),
  uint8Image: image2d_array<rgba8uint, read_write> #texture(11),
  sint8Image: image2d_array<rgba8sint, read_write> #texture(13),
  unorm16Image: image2d_array<rgba16unorm, read_write> #texture(15),
  snorm16Image: image2d_array<rgba16snorm, read_write> #texture(17),
  uint16Image: image2d_array<rgba16uint, read_write> #texture(19),
  sint16Image: image2d_array<rgba16sint, read_write> #texture(21),
  uint32Image: image2d_array<rgba32uint, read_write> #texture(23),
  sint32Image: image2d_array<rgba32sint, read_write> #texture(25),
  packedImage: image2d_array<rg11b10ufloat, read_write> #texture(28),
  bgraImage: image2d_array<bgra8unorm, read_write> #texture(29),
  gid: uint3 #global_id
) {
  let texelCount = 8u * 8u * 2u
  let halfBase = texelCount * 2u + 6u + 12u
  let unorm8Base = halfBase + texelCount * 2u
  let snorm8Base = unorm8Base + texelCount * 2u
  let uint8Base = snorm8Base + texelCount * 2u
  let sint8Base = uint8Base + texelCount * 2u
  let unorm16Base = sint8Base + texelCount * 2u
  let snorm16Base = unorm16Base + texelCount * 2u
  let uint16Base = snorm16Base + texelCount * 2u
  let sint16Base = uint16Base + texelCount * 2u
  let uint32Base = sint16Base + texelCount * 2u
  let sint32Base = uint32Base + texelCount * 2u
  let packedReadBase = halfBase + texelCount * 2u * (11u + 24u) +
                       texelCount
  let packedInputBase = packedReadBase + texelCount
  let bgraBase = packedInputBase + texelCount
  let index = (gid.z * 8u + gid.y) * 8u + gid.x
  let color = image.read(gid) * 2.0 + float4(1.0)
  let halfColor = halfImage.read(gid) * half4(half(2.0)) +
                  half4(half(1.0))
  let unorm8Color = float4(1.0) - unorm8Image.read(gid)
  let snorm8Color = -snorm8Image.read(gid)
  let uint8Color = uint8Image.read(gid) + uint4(1u)
  let sint8Color = sint8Image.read(gid) + int4(7)
  let unorm16Color = float4(1.0) - unorm16Image.read(gid)
  let snorm16Color = -snorm16Image.read(gid)
  let uint16Color = uint16Image.read(gid) + uint4(1u)
  let sint16Color = sint16Image.read(gid) + int4(7)
  let uint32Color = uint32Image.read(gid) + uint4(1u)
  let sint32Color = sint32Image.read(gid) + int4(7)
  let packedOriginal = packedImage.read(gid)
  let bgraOriginal = bgraImage.read(gid)
  let bgraColor = float4(1.0) - bgraOriginal
  image.write(color, gid)
  halfImage.write(halfColor, gid)
  unorm8Image.write(unorm8Color, gid)
  snorm8Image.write(snorm8Color, gid)
  uint8Image.write(uint8Color, gid)
  sint8Image.write(sint8Color, gid)
  unorm16Image.write(unorm16Color, gid)
  snorm16Image.write(snorm16Color, gid)
  uint16Image.write(uint16Color, gid)
  sint16Image.write(sint16Color, gid)
  uint32Image.write(uint32Color, gid)
  sint32Image.write(sint32Color, gid)
  packedImage.write(output[packedInputBase + index], gid)
  bgraImage.write(bgraColor, gid)
  output[texelCount + index] = color
  output[halfBase + texelCount + index] = float4(halfColor)
  output[unorm8Base + texelCount + index] = unorm8Color
  output[snorm8Base + texelCount + index] = snorm8Color
  output[uint8Base + texelCount + index] = float4(uint8Color)
  output[sint8Base + texelCount + index] = float4(sint8Color)
  output[unorm16Base + texelCount + index] = unorm16Color
  output[snorm16Base + texelCount + index] = snorm16Color
  output[uint16Base + texelCount + index] = float4(uint16Color)
  output[sint16Base + texelCount + index] = float4(sint16Color)
  output[uint32Base + texelCount + index] = float4(uint32Color)
  output[sint32Base + texelCount + index] = float4(sint32Color)
  output[packedReadBase + index] = packedOriginal
  output[bgraBase + index] = bgraOriginal
  output[bgraBase + texelCount + index] = bgraColor
}

kern(8, 8, 1) interop_narrow_sample_cs(
  inout output: [float4] #buffer(1),
  r8UnormSampled: texture2d_array<float> #texture(1) #group(1),
  r8SnormSampled: texture2d_array<float> #texture(3) #group(1),
  r8UintSampled: texture2d_array<uint> #texture(5) #group(1),
  r8SintSampled: texture2d_array<int> #texture(7) #group(1),
  r16UnormSampled: texture2d_array<float> #texture(9) #group(1),
  r16SnormSampled: texture2d_array<float> #texture(11) #group(1),
  r16UintSampled: texture2d_array<uint> #texture(13) #group(1),
  r16SintSampled: texture2d_array<int> #texture(15) #group(1),
  r16FloatSampled: texture2d_array<half> #texture(17) #group(1),
  r32UintSampled: texture2d_array<uint> #texture(19) #group(1),
  r32SintSampled: texture2d_array<int> #texture(21) #group(1),
  r32FloatSampled: texture2d_array<float> #texture(23) #group(1),
  rg8UnormSampled: texture2d_array<float> #texture(25) #group(1),
  rg8SnormSampled: texture2d_array<float> #texture(27) #group(1),
  rg8UintSampled: texture2d_array<uint> #texture(29) #group(1),
  rg8SintSampled: texture2d_array<int> #texture(31) #group(1),
  rg16UnormSampled: texture2d_array<float> #texture(33) #group(1),
  rg16SnormSampled: texture2d_array<float> #texture(35) #group(1),
  rg16UintSampled: texture2d_array<uint> #texture(37) #group(1),
  rg16SintSampled: texture2d_array<int> #texture(39) #group(1),
  rg16FloatSampled: texture2d_array<half> #texture(41) #group(1),
  rg32UintSampled: texture2d_array<uint> #texture(43) #group(1),
  rg32SintSampled: texture2d_array<int> #texture(45) #group(1),
  rg32FloatSampled: texture2d_array<float> #texture(47) #group(1),
  gid: uint3 #global_id
) {
  let texelCount = 8u * 8u * 2u
  let halfBase = texelCount * 2u + 6u + 12u
  let r8UnormBase = halfBase + texelCount * 2u * 11u
  let r8SnormBase = r8UnormBase + texelCount * 2u
  let r8UintBase = r8SnormBase + texelCount * 2u
  let r8SintBase = r8UintBase + texelCount * 2u
  let r16UnormBase = r8SintBase + texelCount * 2u
  let r16SnormBase = r16UnormBase + texelCount * 2u
  let r16UintBase = r16SnormBase + texelCount * 2u
  let r16SintBase = r16UintBase + texelCount * 2u
  let r16FloatBase = r16SintBase + texelCount * 2u
  let r32UintBase = r16FloatBase + texelCount * 2u
  let r32SintBase = r32UintBase + texelCount * 2u
  let r32FloatBase = r32SintBase + texelCount * 2u
  let rg8UnormBase = r32FloatBase + texelCount * 2u
  let rg8SnormBase = rg8UnormBase + texelCount * 2u
  let rg8UintBase = rg8SnormBase + texelCount * 2u
  let rg8SintBase = rg8UintBase + texelCount * 2u
  let rg16UnormBase = rg8SintBase + texelCount * 2u
  let rg16SnormBase = rg16UnormBase + texelCount * 2u
  let rg16UintBase = rg16SnormBase + texelCount * 2u
  let rg16SintBase = rg16UintBase + texelCount * 2u
  let rg16FloatBase = rg16SintBase + texelCount * 2u
  let rg32UintBase = rg16FloatBase + texelCount * 2u
  let rg32SintBase = rg32UintBase + texelCount * 2u
  let rg32FloatBase = rg32SintBase + texelCount * 2u
  let index = (gid.z * 8u + gid.y) * 8u + gid.x
  output[r8UnormBase + index] = r8UnormSampled.read(int3(gid))
  output[r8SnormBase + index] = r8SnormSampled.read(int3(gid))
  output[r8UintBase + index] = float4(r8UintSampled.read(int3(gid)))
  output[r8SintBase + index] = float4(r8SintSampled.read(int3(gid)))
  output[r16UnormBase + index] = r16UnormSampled.read(int3(gid))
  output[r16SnormBase + index] = r16SnormSampled.read(int3(gid))
  output[r16UintBase + index] = float4(r16UintSampled.read(int3(gid)))
  output[r16SintBase + index] = float4(r16SintSampled.read(int3(gid)))
  output[r16FloatBase + index] = float4(r16FloatSampled.read(int3(gid)))
  output[r32UintBase + index] = float4(r32UintSampled.read(int3(gid)))
  output[r32SintBase + index] = float4(r32SintSampled.read(int3(gid)))
  output[r32FloatBase + index] = r32FloatSampled.read(int3(gid))
  output[rg8UnormBase + index] = rg8UnormSampled.read(int3(gid))
  output[rg8SnormBase + index] = rg8SnormSampled.read(int3(gid))
  output[rg8UintBase + index] = float4(rg8UintSampled.read(int3(gid)))
  output[rg8SintBase + index] = float4(rg8SintSampled.read(int3(gid)))
  output[rg16UnormBase + index] = rg16UnormSampled.read(int3(gid))
  output[rg16SnormBase + index] = rg16SnormSampled.read(int3(gid))
  output[rg16UintBase + index] = float4(rg16UintSampled.read(int3(gid)))
  output[rg16SintBase + index] = float4(rg16SintSampled.read(int3(gid)))
  output[rg16FloatBase + index] = float4(rg16FloatSampled.read(int3(gid)))
  output[rg32UintBase + index] = float4(rg32UintSampled.read(int3(gid)))
  output[rg32SintBase + index] = float4(rg32SintSampled.read(int3(gid)))
  output[rg32FloatBase + index] = rg32FloatSampled.read(int3(gid))
}

kern(8, 8, 1) interop_narrow_store_cs(
  inout output: [float4] #buffer(1),
  r8UnormImage: image2d_array<r8unorm, read_write> #texture(0) #group(1),
  r8SnormImage: image2d_array<r8snorm, read_write> #texture(2) #group(1),
  r8UintImage: image2d_array<r8uint, read_write> #texture(4) #group(1),
  r8SintImage: image2d_array<r8sint, read_write> #texture(6) #group(1),
  r16UnormImage: image2d_array<r16unorm, read_write> #texture(8) #group(1),
  r16SnormImage: image2d_array<r16snorm, read_write> #texture(10) #group(1),
  r16UintImage: image2d_array<r16uint, read_write> #texture(12) #group(1),
  r16SintImage: image2d_array<r16sint, read_write> #texture(14) #group(1),
  r16FloatImage: image2d_array<r16float, read_write> #texture(16) #group(1),
  r32UintImage: image2d_array<r32uint, read_write> #texture(18) #group(1),
  r32SintImage: image2d_array<r32sint, read_write> #texture(20) #group(1),
  r32FloatImage: image2d_array<r32float, read_write> #texture(22) #group(1),
  rg8UnormImage: image2d_array<rg8unorm, read_write> #texture(24) #group(1),
  rg8SnormImage: image2d_array<rg8snorm, read_write> #texture(26) #group(1),
  rg8UintImage: image2d_array<rg8uint, read_write> #texture(28) #group(1),
  rg8SintImage: image2d_array<rg8sint, read_write> #texture(30) #group(1),
  rg16UnormImage: image2d_array<rg16unorm, read_write> #texture(32) #group(1),
  rg16SnormImage: image2d_array<rg16snorm, read_write> #texture(34) #group(1),
  rg16UintImage: image2d_array<rg16uint, read_write> #texture(36) #group(1),
  rg16SintImage: image2d_array<rg16sint, read_write> #texture(38) #group(1),
  rg16FloatImage: image2d_array<rg16float, read_write> #texture(40) #group(1),
  rg32UintImage: image2d_array<rg32uint, read_write> #texture(42) #group(1),
  rg32SintImage: image2d_array<rg32sint, read_write> #texture(44) #group(1),
  rg32FloatImage: image2d_array<rg32float, read_write> #texture(46) #group(1),
  gid: uint3 #global_id
) {
