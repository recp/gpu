kern(1, 1, 1) f64_storage(
  values:            [double3] #buffer(0),
  matrices:          [double3x3] #buffer(1),
  inout valuesOut:   [double3] #buffer(2),
  inout matricesOut: [double3x3] #buffer(3),
  inout determinantOut: [double4] #buffer(4),
  matrices2:          [double2x2] #buffer(5),
  matrices4:          [double4x4] #buffer(6),
  rightMatrices:      [double3x3] #buffer(7),
  scales:             [double] #buffer(8),
  inout addOut:       [double3x3] #buffer(9),
  inout subOut:       [double3x3] #buffer(10),
  inout mulOut:       [double3x3] #buffer(11),
  inout divOut:       [double3x3] #buffer(12),
  vectors:            [double3] #buffer(13),
  inout productOut:   [double3x3] #buffer(14),
  inout matrixVectorOut: [double3] #buffer(15),
  inout vectorMatrixOut: [double3] #buffer(16),
  mixedLeft:          [double2x3] #buffer(17),
  mixedRight:         [double3x2] #buffer(18),
  inout mixedOut:     [double2x2] #buffer(19),
  inout inverse2Out:  [double2x2] #buffer(20),
  inout inverse3Out:  [double3x3] #buffer(21),
  inout inverse4Out:  [double4x4] #buffer(22),
  lerpValues:         [double4] #buffer(23),
  inout lerpOut:      [double4] #buffer(24),
  inout inverseLerpOut: [double4] #buffer(25),
  inout remapOut:     [double4] #buffer(26),
  inout stepOut:      [double4] #buffer(27),
  inout smoothstepOut: [double4] #buffer(28),
  inout copysignOut:  [double4] #buffer(29),
  inout modOut:       [double4] #buffer(30),
  roundingValues:     [double4] #buffer(31),
  inout floorOut:     [double4] #buffer(32),
  inout ceilOut:      [double4] #buffer(33),
  inout truncOut:     [double4] #buffer(34),
  inout roundOut:     [double4] #buffer(35),
  inout fractOut:     [double4] #buffer(36),
  gid:               uint #global_id
) {
  let matrix = matrices[gid]
  let right = rightMatrices[gid]
  let scale = scales[gid]
  let vector = vectors[gid]
  valuesOut[gid] = values[gid + 1u]
  matricesOut[gid] = transpose(matrix)
  determinantOut[gid] = double4(determinant(matrices2[gid]),
                                 determinant(matrix),
                                 determinant(matrices4[gid]),
                                 1.0)
  addOut[gid] = matrix + right
  subOut[gid] = matrix - right
  mulOut[gid] = scale * matrix
  divOut[gid] = matrix / scale
  productOut[gid] = matrix * right
  matrixVectorOut[gid] = matrix * vector
  vectorMatrixOut[gid] = vector * matrix
  mixedOut[gid] = mixedLeft[gid] * mixedRight[gid]
  inverse2Out[gid] = inverse(matrices2[gid])
  inverse3Out[gid] = inverse(matrix)
  inverse4Out[gid] = inverse(matrices4[gid])
  lerpOut[gid] = lerp(lerpValues[0], lerpValues[1], lerpValues[2])
  inverseLerpOut[gid] = inverselerp(lerpValues[0],
                                    lerpValues[1],
                                    lerpValues[2])
  remapOut[gid] = remap(lerpValues[0],
                        lerpValues[1],
                        lerpValues[3],
                        lerpValues[4],
                        lerpValues[2])
  stepOut[gid] = step(lerpValues[0], lerpValues[1])
  smoothstepOut[gid] = smoothstep(lerpValues[0],
                                  lerpValues[1],
                                  lerpValues[2])
  copysignOut[gid] = copysign(lerpValues[0],
                              double4(-0.0, 1.0, -1.0, 0.0))
  modOut[gid] = mod(double4(lerpValues[2].x,
                            lerpValues[2].w,
                            lerpValues[2].z,
                            lerpValues[0].z),
                    double4(lerpValues[1].x,
                            lerpValues[1].w,
                            lerpValues[1].z,
                            lerpValues[1].z))
  floorOut[0] = floor(roundingValues[0])
  floorOut[1] = floor(roundingValues[1])
  floorOut[2] = floor(roundingValues[2])
  ceilOut[0] = ceil(roundingValues[0])
  ceilOut[1] = ceil(roundingValues[1])
  ceilOut[2] = ceil(roundingValues[2])
  truncOut[0] = trunc(roundingValues[0])
  truncOut[1] = trunc(roundingValues[1])
  truncOut[2] = trunc(roundingValues[2])
  roundOut[0] = round(roundingValues[0])
  roundOut[1] = round(roundingValues[1])
  roundOut[2] = round(roundingValues[2])
  fractOut[0] = fract(roundingValues[0])
  fractOut[1] = fract(roundingValues[1])
  fractOut[2] = fract(roundingValues[2])
}
