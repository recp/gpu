struct Params {
  scale: float
  bias:  float
}

kern(256) saxpy(values: [float] #buffer(0) #group(1),
                inout output: [float] #buffer(1) #group(1),
                params: Params #buffer(0) #group(0) #dynamic_offset,
                globalId: uint #global_id) {
  output[globalId] = values[globalId] * params.scale + params.bias
}
