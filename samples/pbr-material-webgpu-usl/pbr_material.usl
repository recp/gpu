import <std/gltf_pbr>

struct PBRUniforms {
  mvp:             float4x4
  model:           float4x4
  cameraPosition:  float4
  lightDirection:  float4
}

vertex PBRVertex {
  position: float3
  normal:   float3
  tangent:  float4
  uv:       float2
}

struct PBROut {
  position:      float4 #position
  worldPosition: float3
  normal:        float3
  tangent:       float3
  bitangent:     float3
  uv:            float2
}

vert pbr_vs(v: PBRVertex #stage_in,
            frame: PBRUniforms #buffer(0)) -> PBROut {
  let worldPosition = frame.model * float4(v.position, 1.0)
  let normal        = normalize((frame.model * float4(v.normal, 0.0)).xyz)
  let tangent       = normalize((frame.model * float4(v.tangent.xyz, 0.0)).xyz)
  return PBROut {
    frame.mvp * float4(v.position, 1.0),
    worldPosition.xyz,
    normal,
    tangent,
    normalize(cross(normal, tangent)) * v.tangent.w,
    v.uv
  }
}

frag pbr_fs(input: PBROut #stage_in,
            frame: PBRUniforms #buffer(0),
            albedoTex: texture2d<float> #texture(0) #group(1),
            normalTex: texture2d<float> #texture(1) #group(1),
            materialTex: texture2d<float> #texture(2) #group(1),
            environment: texturecube<float> #texture(3) #group(1),
            materialSampler: sampler #sampler(4) #group(1)) -> float4 {
  let albedoSample   = albedoTex.sample(materialSampler, input.uv)
  let normalSample   = normalTex.sample(materialSampler, input.uv)
  let materialSample = materialTex.sample(materialSampler, input.uv)
  let factors        = metallic_roughness_factors(1.0, 1.0, materialSample)
  let n              = normal_world_from_tangent(normalSample.xyz, 1.0,
                                                 normalize(input.normal),
                                                 normalize(input.tangent),
                                                 normalize(input.bitangent))
  let v              = normalize(frame.cameraPosition.xyz - input.worldPosition)
  let l              = normalize(frame.lightDirection.xyz)
  let reflected      = reflect(-v, n)
  let diffuseEnv     = environment.sample(materialSampler, n).rgb * 0.22
  let specularEnv    = environment.sample(materialSampler, reflected).rgb * 0.55
  let color          = shade_metallic_roughness(albedoSample.rgb,
                                                factors.x,
                                                factors.y,
                                                n,
                                                v,
                                                l,
                                                float3(4.6, 4.1, 3.7),
                                                diffuseEnv,
                                                specularEnv,
                                                materialSample.r,
                                                float3(0.0))
  return float4(tonemap_output(color), 1.0)
}
