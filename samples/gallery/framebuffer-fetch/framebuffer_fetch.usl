struct DrawConstants {
  rect: float4
  tint: float4
}

vert fetch_vs(vertexId: uint          #vertex_id,
              draw:     DrawConstants #push_constant) -> float4 {
  var point: float2
  if (vertexId == 0) { point = float2(0.0, 0.85) }
  else if (vertexId == 1) { point = float2(-0.8, -0.75) }
  else { point = float2(0.8, -0.75) }
  return float4(point * draw.rect.zw + draw.rect.xy, 0.0, 1.0)
}

frag fetch_fs(dst:  float4        #color(0),
              draw: DrawConstants #push_constant) -> float4 {
  return draw.tint + dst * (1.0 - draw.tint.a)
}
