struct VSOut {
  position: float4 #position
  color:    float4
}

vertex VSIn {
  offset: float2
  color:  float4
}

vert multi_vs(input: VSIn #stage_in,
              vertexId: uint #vertex_id) -> VSOut {
  let localId = vertexId % 3u
  let x = localId == 0u
    ? input.offset.x
    : (localId == 1u ? input.offset.x - 0.34 : input.offset.x + 0.34)
  let y = localId == 0u ? 0.62 : -0.50

  return { {x, y, 0.0, 1.0}, input.color }
}

frag multi_fs(input: VSOut #stage_in) -> float4 {
  return input.color
}
