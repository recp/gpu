@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@GPU_CONFIG_NEEDS_VULKAN@)
  find_dependency(Vulkan)
endif()

if(NOT TARGET ds::ds)
  include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/ds/cmake/ds.cmake")
endif()
if(NOT TARGET us::us)
  include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/us/cmake/us.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gpuTargets.cmake")
if(@GPU_CONFIG_HAS_WEBGPU_STATIC_PROVIDER@)
  set_property(TARGET gpu::webgpu_provider APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES
      "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@GPU_CONFIG_WEBGPU_STATIC_PROVIDER_FILENAME@"
  )
endif()
check_required_components(gpu)
